[app]
# Loglevel can be one of: debug, info, warning, error, critical
loglevel=debug
# Uranumber of the NVI service
nvi_ura_number = 12345678
# Hashing key-id to use for hashing the pseudonyms
hashing_key_id=abcdef1234567890
# Whether to suppress urllib3 InsecureRequestWarning
allow_insecure_requests = False

[logging]
# All keys are optional. When syslog_path is omitted, logs only go to stdout.
# Single syslog channel in host:port format (UDP). All streams (app, siem,
# public_inspect, debug) are sent here; each JSON record carries a stream_id
# field so the log server can tell them apart.
syslog_path = syslog:5514
# Identifies this application in the JSON records (application_id field),
# so the log server can tell apart applications sharing the channel.
application_id = nationale-verwijsindex-crypto-service-api
# Include exception/stack traces in JSON logs
include_traces = True
# Whether to display debug logs in the console
debug_logs_in_console = True

[hsm_api]
# If true, use a pass-through mock instead of calling the HSM API
mock = True
# Url to the HSM api
url = http://localhost:8000
# Module of the HSM
module = softhsm
# Label of the slot to use for the HSM api
slot = SoftHSMLabel
# verify CA, supports path to file or bool
verify_ca = secrets/hsm-api-ca.crt
# Certificate path for the HSM api
cert_path = secrets/hsm-api.crt
# Key path for the HSM api
key_path = secrets/hsm-api.key
# Also support SHA-1 next to SHA-256
support_sha1 = False

[telemetry]
# Telemetry is enabled or not
enabled = False
# Endpoint to GRPC server for telemetry
endpoint = http://tracing:4317
# Service name to use
service_name = nationale verwijsindex crypto service api
# Tracer name to use
tracer_name = zmodules.service.nationale-verwijsindex-crypto-service-api

[stats]
# Statsd is enabled or not
enabled = False
# Host for statsd server
host = 127.0.0.1
# Port for statsd server
port = 8125
# Module name for statsd
module_name = localisation

[uvicorn]
# If true, the api docs will be enabled
swagger_enabled = True
# Endpoint for swagger api docs
docs_url = /docs
# Endpoint for redoc api docs
redoc_url = /redocs
# Host for the uvicorn server
host = 0.0.0.0
# Port for the uvicorn server
port = 8577
# Live reload for uvicorn server
reload = True

# SSL configuration
use_ssl = False
ssl_base_dir = secrets/ssl
ssl_cert_file = server.cert
ssl_key_file = server.key
